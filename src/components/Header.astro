---
const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const navItems = [
  { name: 'Inicio', path: baseUrl },
  { name: 'Número Actual', path: `${baseUrl}numero-actual` },
  { name: 'Convocatorias', path: `${baseUrl}convocatorias` },
  { 
    name: 'Acerca de', 
    path: `${baseUrl}sobre-la-revista`,
    isDropdown: true,
    subItems: [
      { name: 'Sobre la revista', path: `${baseUrl}sobre-la-revista` },
      { name: 'Equipo editorial', path: `${baseUrl}equipo-editorial` },
      { name: 'Contacto', path: `${baseUrl}contacto` }
    ]
  },
  { name: 'Directrices para Autores', path: `${baseUrl}directrices-para-autores` },
];

function isActive(item: any) {
  if (item.path === baseUrl && currentPath === baseUrl) return true;
  if (item.isDropdown && item.subItems) {
    return item.subItems.some((sub: any) => {
      const subSlug = sub.path.replace(baseUrl, '').replace(/^\//, '');
      return currentPath.includes(subSlug);
    });
  }
  const itemSlug = item.path.replace(baseUrl, '').replace(/^\//, '');
  if (itemSlug && currentPath.includes(itemSlug)) return true;
  return false;
}
---

<header class="w-full bg-paper border-b border-pistachio-300 sticky top-0 z-40 backdrop-blur-md bg-opacity-95 transition-all shadow-2xs">
  <!-- Top bar editorial en Verde Bosque -->
  <div class="bg-forest-800 py-1.5 px-4 text-xs font-sans text-pistachio-100 tracking-wider">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-pistachio-300 animate-pulse"></span>
          <strong class="font-medium text-white">Convocatoria Abierta — Vol. 1, N° 1</strong>
        </span>
        <span class="hidden sm:inline text-forest-700">|</span>
        <span class="hidden sm:inline text-pistachio-200">Revista Chilena de Lectura y Escritura desde la Diversidad</span>
      </div>
      <div class="flex items-center gap-4">
        <a href={`${baseUrl}admin`} class="hover:text-white transition-colors flex items-center gap-1 text-pistachio-200 text-[11px]">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002-2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
          <span>Panel Admin</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Branding Principal Elegante Serif -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col md:flex-row justify-between items-center gap-4">
    <a href={baseUrl} class="group text-center md:text-left flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-pistachio-200 border border-forest-800/40 flex items-center justify-center text-forest-900 font-serif font-bold text-xl shrink-0 shadow-2xs group-hover:scale-105 transition-transform">
        🦎
      </div>

      <div class="flex flex-col">
        <span class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-forest-900 group-hover:text-forest-700 transition-colors">
          Revista Literaria Anfibias
        </span>
        <span class="font-sans text-xs sm:text-sm text-forest-800 tracking-widest uppercase mt-0.5 font-semibold">
          Voces Femeninas, Feministas, Queer y Críticas · Chile
        </span>
      </div>
    </a>
    
    <div class="hidden lg:flex items-center gap-3 text-xs text-forest-900 border-l border-pistachio-300 pl-6 py-1 font-serif italic">
      <p class="max-w-xs leading-snug">
        «Espacio de lectura y escritura desde la diversidad: literatura, pensamiento crítico y experimentación narrativa.»
      </p>
    </div>
  </div>

  <!-- Navegación Principal -->
  <nav class="border-t border-pistachio-300 bg-pistachio-100/60" aria-label="Navegación principal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-12">
        <!-- Enlaces escritorio -->
        <div class="hidden md:flex items-center space-x-8">
          {navItems.map((item) => {
            if (item.isDropdown) {
              return (
                <div class="relative dropdown-parent group" id="desktop-acerca-container">
                  <button
                    id="acerca-de-btn"
                    type="button"
                    aria-expanded="false"
                    class={`text-sm font-medium tracking-wide transition-colors py-3 border-b-2 flex items-center gap-1.5 focus:outline-none cursor-pointer ${
                      isActive(item)
                        ? 'border-forest-900 text-forest-900 font-semibold'
                        : 'border-transparent text-ink-800 hover:text-forest-900 hover:border-pistachio-400'
                    }`}
                  >
                    <span>{item.name}</span>
                    <svg id="acerca-chevron" class="w-3.5 h-3.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>

                  <!-- Menú Desplegable (Hover & Click) hacia páginas separadas -->
                  <div
                    id="acerca-de-menu"
                    class="dropdown-popover absolute left-0 top-full pt-1 z-50 w-56 hidden"
                  >
                    <div class="bg-white border border-pistachio-300 rounded-xl shadow-xl py-2 px-1 text-sm font-sans divide-y divide-pistachio-100">
                      <div class="py-1">
                        {item.subItems.map((sub) => {
                          const isSubActive = currentPath.includes(sub.path.replace(baseUrl, '').replace(/^\//, ''));
                          return (
                            <a
                              href={sub.path}
                              class={`block px-3 py-2 rounded-lg font-medium transition-colors ${
                                isSubActive
                                  ? 'bg-pistachio-100 text-forest-900 font-semibold'
                                  : 'text-ink-800 hover:bg-pistachio-50 hover:text-forest-900'
                              }`}
                            >
                              {sub.name}
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              );
            }

            return (
              <a
                href={item.path}
                class={`text-sm font-medium tracking-wide transition-colors py-3 border-b-2 ${
                  isActive(item)
                    ? 'border-forest-900 text-forest-900 font-semibold'
                    : 'border-transparent text-ink-800 hover:text-forest-900 hover:border-pistachio-400'
                }`}
              >
                {item.name}
              </a>
            );
          })}
        </div>

        <!-- Acceso rápido -->
        <div class="hidden md:flex items-center">
          <a 
            href={`${baseUrl}convocatorias`}
            class="text-xs uppercase tracking-wider font-semibold bg-forest-800 text-white hover:bg-forest-900 px-3.5 py-1.5 rounded transition-all shadow-2xs flex items-center gap-1.5"
          >
            <span>Convocatoria N° 1</span>
          </a>
        </div>

        <!-- Botón menú móvil -->
        <div class="flex md:hidden w-full justify-between items-center py-2">
          <span class="text-xs uppercase tracking-widest text-forest-900 font-semibold">Menú Anfibias</span>
          <button
            id="mobile-menu-btn"
            type="button"
            class="p-2 text-forest-900 focus:outline-none"
            aria-label="Abrir menú"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Menú desplegable móvil -->
      <div id="mobile-menu" class="hidden md:hidden pb-4 pt-2 border-t border-pistachio-300">
        <div class="flex flex-col space-y-2">
          {navItems.map((item) => {
            if (item.isDropdown) {
              return (
                <div class="space-y-1">
                  <button
                    id="mobile-acerca-toggle"
                    type="button"
                    class={`w-full text-left px-3 py-2 text-sm font-medium rounded flex justify-between items-center ${
                      isActive(item)
                        ? 'bg-pistachio-200 text-forest-900 font-semibold'
                        : 'text-ink-800 hover:bg-pistachio-100 hover:text-forest-900'
                    }`}
                  >
                    <span>{item.name}</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>
                  <div id="mobile-acerca-sub" class="hidden pl-4 py-1 space-y-1 bg-pistachio-50/50 rounded-lg">
                    {item.subItems.map((sub) => (
                      <a
                        href={sub.path}
                        class="block px-3 py-1.5 text-xs font-medium text-ink-700 hover:text-forest-900"
                      >
                        • {sub.name}
                      </a>
                    ))}
                  </div>
                </div>
              );
            }

            return (
              <a
                href={item.path}
                class={`px-3 py-2 text-sm font-medium rounded ${
                  isActive(item)
                    ? 'bg-pistachio-200 text-forest-900 font-semibold'
                    : 'text-ink-800 hover:bg-pistachio-100 hover:text-forest-900'
                }`}
              >
                {item.name}
              </a>
            );
          })}
          <a
            href={`${baseUrl}convocatorias`}
            class="mt-2 text-center text-xs uppercase tracking-wider font-semibold bg-forest-800 text-white py-2 rounded"
          >
            Enviar Trabajo (Cierre 02 de Mayo)
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  /* Menú desplegable en escritorio: visible en hover o al hacer clic */
  #desktop-acerca-container:hover #acerca-de-menu,
  #desktop-acerca-container.is-open #acerca-de-menu {
    display: block !important;
  }
  #desktop-acerca-container:hover #acerca-chevron,
  #desktop-acerca-container.is-open #acerca-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  // Control interactivo del menú móvil
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Toggle de submenú móvil Acerca de
  const mobileAcercaToggle = document.getElementById('mobile-acerca-toggle');
  const mobileAcercaSub = document.getElementById('mobile-acerca-sub');
  if (mobileAcercaToggle && mobileAcercaSub) {
    mobileAcercaToggle.addEventListener('click', () => {
      mobileAcercaSub.classList.toggle('hidden');
    });
  }

  // Toggle por clic en escritorio para Acerca de
  const acercaContainer = document.getElementById('desktop-acerca-container');
  const acercaBtn = document.getElementById('acerca-de-btn');
  if (acercaContainer && acercaBtn) {
    acercaBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      acercaContainer.classList.toggle('is-open');
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!acercaContainer.contains(target)) {
        acercaContainer.classList.remove('is-open');
      }
    });
  }
</script>
