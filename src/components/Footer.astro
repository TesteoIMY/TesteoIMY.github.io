---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentYear = new Date().getFullYear();
---

<footer class="bg-forest-900 text-pistachio-100 font-sans border-t-4 border-forest-800 mt-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Columna 1: Revista & Identidad -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-3xl">🦎</span>
          <h2 class="font-script text-4xl font-bold text-magenta-500 drop-shadow-xs">
            Revista Literaria Anfibias
          </h2>
        </div>
        <p class="text-sm text-pistachio-200 max-w-md leading-relaxed font-medium">
          Revista chilena que posee un espacio de lectura y escritura desde la diversidad: voces femeninas, feministas, queer y críticas. Su propósito es abrir un lugar de encuentro para la literatura, el pensamiento crítico y la experimentación narrativa.
        </p>
        <div class="pt-2 text-xs text-pistachio-300 space-y-1 font-sans">
          <p><strong class="text-white">Correo Oficial de Envíos:</strong> <a href="mailto:revistaliterariaanfibias@gmail.com" class="underline text-magenta-300 hover:text-white">revistaliterariaanfibias@gmail.com</a></p>
          <p><strong class="text-white">Directora General:</strong> Alexandra Novoa Romero</p>
          <p><strong class="text-white">Coordinación Editorial:</strong> Jana Aravena Riquelme & Pamela Valdés Peña</p>
        </div>
      </div>

      <!-- Columna 2: Navegación Rápida -->
      <div>
        <h3 class="text-xs uppercase tracking-widest font-bold text-magenta-400 mb-4 border-b border-forest-700 pb-2">
          Secciones & Menú
        </h3>
        <ul class="space-y-2.5 text-sm font-semibold">
          <li><a href={baseUrl} class="hover:text-magenta-300 transition-colors">Inicio</a></li>
          <li><a href={`${baseUrl}numero-actual`} class="hover:text-magenta-300 transition-colors">Volumen 1, N° 1</a></li>
          <li><a href={`${baseUrl}convocatorias`} class="hover:text-magenta-300 transition-colors">Convocatoria Abierta</a></li>
          <li><a href={`${baseUrl}acerca-de`} class="hover:text-magenta-300 transition-colors">Sobre la Revista & Equipo</a></li>
          <li><a href={`${baseUrl}admin`} class="hover:text-magenta-300 transition-colors text-pistachio-400">Panel Admin (Demo)</a></li>
        </ul>
      </div>

      <!-- Columna 3: Licencia y Directrices -->
      <div>
        <h3 class="text-xs uppercase tracking-widest font-bold text-magenta-400 mb-4 border-b border-forest-700 pb-2">
          Directrices para Autores
        </h3>
        <p class="text-xs text-pistachio-200 leading-relaxed mb-4">
          Manuscritos enviados en formato <strong>Word (.doc/.docx)</strong>, Arial o Times 12pt, interlineado 1.5 y citas en <strong>APA 7.ª edición</strong>.
        </p>
        <div class="flex items-center space-x-3 pt-2 text-xs text-pistachio-300 font-bold">
          <a href="mailto:revistaliterariaanfibias@gmail.com" class="hover:text-white underline text-magenta-300">Contacto Directo</a>
          <span>·</span>
          <a href="#" class="hover:text-white">Instagram</a>
        </div>
      </div>

    </div>

    <!-- Barra Inferior -->
    <div class="mt-12 pt-6 border-t border-forest-800 flex flex-col sm:flex-row justify-between items-center text-xs text-pistachio-300 gap-4 font-medium">
      <p>© {currentYear} Revista Literaria Anfibias · Chile. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1">
        <span>Diseñado en Astro & Tailwind CSS</span>
        <span class="text-forest-700">|</span>
        <span>Alojado en GitHub Pages</span>
      </p>
    </div>
  </div>
</footer>
