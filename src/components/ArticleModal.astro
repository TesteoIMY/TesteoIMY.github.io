---
---

<div 
  id="article-modal" 
  class="fixed inset-0 z-50 hidden bg-forest-950/60 backdrop-blur-sm overflow-y-auto p-4 sm:p-6 md:p-10 flex justify-center items-start transition-opacity duration-300"
  aria-labelledby="modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="relative bg-paper text-ink-900 rounded-xl shadow-2xl max-w-3xl w-full border border-pistachio-300 my-8 p-6 sm:p-10 overflow-hidden fade-in">
    
    <!-- Botón de Cierre -->
    <button 
      id="close-modal-btn"
      type="button"
      class="absolute top-5 right-5 p-2 text-ink-600 hover:text-forest-900 bg-pistachio-100 hover:bg-pistachio-200 rounded-full transition-colors focus:outline-none"
      aria-label="Cerrar modal"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Encabezado del artículo -->
    <header class="border-b border-pistachio-300 pb-6 mb-6">
      <div class="flex items-center gap-3 text-xs text-ink-600 mb-3 font-sans">
        <span id="modal-category" class="bg-forest-800 text-white font-semibold px-2.5 py-0.5 rounded text-[11px] uppercase tracking-wider">
          Categoría
        </span>
        <span id="modal-date">Fecha</span>
        <span>·</span>
        <span id="modal-read-time">5 min</span>
      </div>

      <h1 id="modal-title" class="font-serif text-2xl sm:text-4xl font-bold text-forest-900 leading-tight mb-2">
        Título del Artículo
      </h1>

      <p id="modal-subtitle" class="font-serif italic text-base sm:text-lg text-forest-800 mb-4 leading-relaxed">
        Subtítulo
      </p>

      <div class="flex items-center justify-between gap-4 pt-2">
        <div class="text-xs font-sans text-ink-900">
          <span>Por <strong id="modal-author" class="font-semibold text-forest-900">Autor/a</strong></span>
          <p id="modal-author-bio" class="text-ink-600 text-[11px] italic mt-0.5">Biografía autor/a</p>
        </div>

        <button 
          id="modal-pdf-download"
          type="button"
          class="shrink-0 bg-forest-800 text-white hover:bg-forest-900 text-xs px-3.5 py-1.5 rounded flex items-center gap-1.5 transition-colors font-sans shadow-2xs font-semibold"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span>Descargar PDF</span>
        </button>
      </div>
    </header>

    <!-- Contenido del Artículo -->
    <div id="modal-content" class="prose prose-neutral max-w-none font-sans text-ink-900 leading-relaxed space-y-4">
      <!-- Inyectado vía JS -->
    </div>

    <!-- Pie del Modal -->
    <footer class="mt-10 pt-6 border-t border-pistachio-300 flex justify-between items-center text-xs text-ink-600 font-sans">
      <p>Revista Literaria Anfibias · Chile</p>
      <button 
        id="close-modal-bottom-btn" 
        type="button" 
        class="text-forest-900 font-semibold hover:underline"
      >
        Volver a la portada ↑
      </button>
    </footer>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('article-modal');
    const closeBtn = document.getElementById('close-modal-btn');
    const closeBottomBtn = document.getElementById('close-modal-bottom-btn');
    const modalPdfBtn = document.getElementById('modal-pdf-download');

    function closeModal() {
      if (modal) {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    function openModalWithArticle(articleData: any) {
      if (!modal) return;

      const titleEl = document.getElementById('modal-title');
      const subtitleEl = document.getElementById('modal-subtitle');
      const categoryEl = document.getElementById('modal-category');
      const dateEl = document.getElementById('modal-date');
      const authorEl = document.getElementById('modal-author');
      const authorBioEl = document.getElementById('modal-author-bio');
      const contentEl = document.getElementById('modal-content');
      const readTimeEl = document.getElementById('modal-read-time');

      if (titleEl) titleEl.textContent = articleData.titulo;
      if (subtitleEl) {
        subtitleEl.textContent = articleData.subtitulo || '';
        subtitleEl.style.display = articleData.subtitulo ? 'block' : 'none';
      }
      if (categoryEl) categoryEl.textContent = articleData.categoria;
      if (dateEl) dateEl.textContent = articleData.fecha;
      if (authorEl) authorEl.textContent = articleData.autor;
      if (authorBioEl) authorBioEl.textContent = articleData.biografiaAutor || '';
      if (readTimeEl) readTimeEl.textContent = `${articleData.lecturaMinutos || 5} min`;
      if (contentEl) contentEl.innerHTML = articleData.contenido || articleData.resumen;

      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest('.open-article-btn');
      if (btn) {
        const rawData = btn.getAttribute('data-article');
        if (rawData) {
          try {
            const data = JSON.parse(rawData);
            openModalWithArticle(data);
          } catch (err) {
            console.error('Error parseando artículo', err);
          }
        }
      }

      const pdfBtn = target.closest('.download-pdf-btn');
      if (pdfBtn) {
        const title = pdfBtn.getAttribute('data-title') || 'Artículo';
        const autor = pdfBtn.getAttribute('data-autor') || 'Anfibias';
        alert(`Generando y descargando versión maqueta PDF para:\n"${title}" por ${autor}\n\n(Archivo de demostración estático preparado para GitHub Pages)`);
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (closeBottomBtn) closeBottomBtn.addEventListener('click', closeModal);

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    if (modalPdfBtn) {
      modalPdfBtn.addEventListener('click', () => {
        const titleEl = document.getElementById('modal-title');
        const title = titleEl ? titleEl.textContent : 'Artículo';
        alert(`Descargando documento PDF:\n"${title}"\n(Simulación de descarga PDF en GitHub Pages)`);
      });
    }
  });
</script>
