---
import Layout from '../layouts/Layout.astro';
import BannerConvocatoria from '../components/BannerConvocatoria.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="Revista Literaria Anfibias | Lectura y escritura desde la diversidad" 
  description="Revista chilena que posee un espacio de lectura y escritura desde la diversidad: voces femeninas, feministas, queer y críticas."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Hero Editorial Elegante Serif -->
    <section class="border-b border-pistachio-300 pb-12 mb-10 text-center sm:text-left">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-forest-800 text-white rounded text-xs font-sans font-semibold mb-4 tracking-wider uppercase shadow-2xs">
          <span>🦎 Revista Chilena</span>
          <span>·</span>
          <span>Volumen 1, N° 1</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-6xl font-extrabold tracking-tight text-forest-900 leading-[1.1] mb-6">
          Lectura y escritura desde la diversidad: voces femeninas, feministas y queer.
        </h1>

        <p class="font-sans text-lg sm:text-xl text-ink-800 leading-relaxed max-w-3xl mb-6 font-light">
          Un espacio de encuentro para la literatura, el pensamiento crítico y la experimentación narrativa.
        </p>

        <div class="flex flex-wrap gap-3 justify-center sm:justify-start text-xs font-sans font-medium text-forest-900">
          <span class="flex items-center gap-1.5 bg-white border border-pistachio-300 px-3 py-1.5 rounded shadow-2xs">
            <span class="text-forest-700">✓</span> Ensayos Críticos (hasta 2.000 palabras)
          </span>
          <span class="flex items-center gap-1.5 bg-white border border-pistachio-300 px-3 py-1.5 rounded shadow-2xs">
            <span class="text-forest-700">✓</span> Reseñas de Libros (1.000–1.500 palabras)
          </span>
          <span class="flex items-center gap-1.5 bg-white border border-pistachio-300 px-3 py-1.5 rounded shadow-2xs">
            <span class="text-forest-700">✓</span> Artículos & Relatos (hasta 3.000 palabras)
          </span>
          <span class="flex items-center gap-1.5 bg-white border border-pistachio-300 px-3 py-1.5 rounded shadow-2xs">
            <span class="text-forest-700">✓</span> Escrituras Anfibias Híbridas
          </span>
        </div>
      </div>
    </section>

    <!-- Convocatoria Abierta Banner -->
    <BannerConvocatoria />

  </div>
</Layout>
