---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleModal from '../components/ArticleModal.astro';
import initialArticles from '../data/articulos.json';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const categorias = ['Todos', 'Ensayos', 'Reseñas', 'Artículos', 'Escrituras anfibias'];
---

<Layout 
  title="Número Actual | Revista Literaria Anfibias (Vol. 1, N° 1)" 
  description="Maquetación e índice de artículos del Volumen 1, Número 1 de Revista Literaria Anfibias."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Módulo de Cabecera del Volumen (Imagen 4) -->
    <div class="bg-paper border-2 border-forest-800/30 rounded-2xl p-8 sm:p-12 shadow-md mb-12">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        
        <!-- Portada gráfica simulada del volumen -->
        <div class="md:col-span-4 flex justify-center">
          <div class="w-64 h-88 bg-forest-900 text-white rounded-2xl shadow-xl p-6 flex flex-col justify-between border-4 border-forest-800 relative group overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-forest-800/40 to-forest-950 pointer-events-none"></div>
            
            <div class="relative z-10">
              <span class="text-[10px] uppercase tracking-widest font-sans font-bold text-pistachio-200 block mb-1">Revista Literaria</span>
              <div class="flex items-center gap-1">
                <span class="text-2xl">🦎</span>
                <h2 class="font-serif text-3xl font-bold tracking-tight text-white leading-none">Anfibias</h2>
              </div>
              <span class="text-[11px] font-sans italic text-pistachio-200 block border-b border-forest-700 pb-2 mt-1 font-medium">Palabras en movimiento</span>
            </div>

            <div class="relative z-10 my-4 text-center">
              <span class="text-xs uppercase font-mono tracking-widest text-pistachio-200 font-bold">VOLUMEN 1, N° 1</span>
              <p class="font-serif italic text-lg text-white mt-1 leading-snug font-bold">«Lectura y escritura desde la diversidad»</p>
            </div>

            <div class="relative z-10 pt-2 border-t border-forest-700 flex justify-between items-end text-[10px] font-sans text-pistachio-200 font-bold">
              <span>Chile · 2024/2025</span>
              <span>Open Access</span>
            </div>
          </div>
        </div>

        <!-- Ficha técnica del volumen -->
        <div class="md:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-forest-800 text-white rounded-full text-xs font-sans font-bold shadow-xs">
            <span>Edición Inaugural</span>
            <span>·</span>
            <span>Volumen 1, N° 1</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-forest-900 leading-tight">
            Volumen 1, Número 1: Corporalidades y Escrituras Disidentes
          </h1>

          <p class="font-sans text-ink-900 text-sm sm:text-base leading-relaxed font-medium">
            Reúne los primeros ensayos críticos, escrituras anfibias e intervenciones poéticas que abren el camino de la revista en Chile. Voces femeninas, feministas y queer que interrogan la norma y la forma.
          </p>

          <div class="pt-4 border-t border-forest-800/20 flex flex-wrap gap-4 text-xs font-sans text-ink-900 font-medium">
            <div><strong class="text-forest-900">Directora:</strong> Alexandra Novoa Romero</div>
            <div><strong class="text-forest-900">Coordinación:</strong> Jana Aravena Riquelme & Pamela Valdés Peña</div>
            <div><strong class="text-forest-900">Formato:</strong> Word / PDF Digital Libre</div>
          </div>

          <div class="pt-2 flex flex-wrap gap-3">
            <button 
              id="download-full-volume-btn"
              type="button" 
              class="bg-forest-800 hover:bg-forest-900 text-white text-xs font-bold px-5 py-2.5 rounded-full transition-colors inline-flex items-center gap-2 shadow-md"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              <span>Descargar Edición Compilada (PDF)</span>
            </button>
            
            <a 
              href={`${baseUrl}convocatorias`} 
              class="bg-white hover:bg-pistachio-100 text-forest-900 text-xs font-bold px-5 py-2.5 rounded-full border-2 border-forest-800 transition-colors inline-flex items-center gap-2 shadow-xs"
            >
              <span>Ver convocatoria activa Vol. 1 N° 1</span>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Sección de Artículos del Volumen (Estilo Imagen 2 que reemplaza al Sumario Imagen 3) -->
    <section class="space-y-8 mt-12">
      
      <!-- Cabecera de la Sección y Filtros -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-pistachio-300 pb-4">
        <div>
          <h2 class="font-serif text-2xl font-bold text-forest-900">
            Textos & Publicaciones Recientes
          </h2>
          <p class="text-xs text-ink-600 font-sans mt-0.5">
            Filtra por nuestras secciones de ensayos, reseñas, artículos y escrituras anfibias.
          </p>
        </div>

        <!-- Filtro de Categorías -->
        <div class="flex flex-wrap gap-1.5" id="category-filters">
          {categorias.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class={`category-filter-btn px-3 py-1 rounded text-xs font-medium font-sans transition-colors ${
                idx === 0
                  ? 'bg-forest-800 text-white shadow-2xs font-semibold'
                  : 'bg-pistachio-100 text-forest-900 hover:bg-pistachio-200 border border-pistachio-200'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Contenedor dinámico de la Grilla de Artículos -->
      <div 
        id="articles-grid" 
        class="grid grid-cols-1 sm:grid-cols-2 gap-6"
        data-initial-articles={JSON.stringify(initialArticles)}
      >
        {initialArticles.map((articulo) => (
          <div class="article-item-wrapper" data-category={articulo.categoria}>
            <ArticleCard articulo={articulo} />
          </div>
        ))}
      </div>

      <!-- Aviso para artículos vacíos tras filtrado -->
      <div id="no-articles-msg" class="hidden text-center py-12 bg-white border border-pistachio-300 rounded-xl">
        <p class="font-serif text-lg text-ink-600 italic">No hay textos publicados en esta categoría por el momento.</p>
        <a href={`${baseUrl}convocatorias`} class="mt-2 inline-block text-xs uppercase tracking-wider font-semibold text-forest-800 underline">
          Envía tu manuscrito →
        </a>
      </div>

    </section>

  </div>

  <ArticleModal />
</Layout>

<script>
  import { getArticles } from '../utils/articlesManager.js';

  document.addEventListener('DOMContentLoaded', () => {
    // Manejo de descarga del volumen completo
    const fullVolBtn = document.getElementById('download-full-volume-btn');
    if (fullVolBtn) {
      fullVolBtn.addEventListener('click', () => {
        alert('Generando PDF del Volumen 1, Número 1.\n\n(Simulación de descarga estática para GitHub Pages)');
      });
    }

    // Manejo de la grilla y filtros de categorías
    const grid = document.getElementById('articles-grid');
    const noArticlesMsg = document.getElementById('no-articles-msg');
    const filterBtns = document.querySelectorAll('.category-filter-btn');

    function renderArticles(selectedCategory = 'Todos') {
      if (!grid) return;

      const articles = getArticles();
      grid.innerHTML = '';

      const filtered = selectedCategory === 'Todos' 
        ? articles 
        : articles.filter(a => a.categoria === selectedCategory);

      if (filtered.length === 0) {
        if (noArticlesMsg) noArticlesMsg.classList.remove('hidden');
      } else {
        if (noArticlesMsg) noArticlesMsg.classList.add('hidden');

        filtered.forEach(articulo => {
          const wrapper = document.createElement('div');
          wrapper.className = 'article-item-wrapper fade-in';
          wrapper.setAttribute('data-category', articulo.categoria);

          wrapper.innerHTML = `
            <article class="bg-white border border-pistachio-300 rounded-xl p-6 hover:border-forest-700 hover:shadow-md transition-all duration-300 flex flex-col justify-between h-full group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3 text-xs text-ink-600 font-sans">
                  <span class="inline-block bg-pistachio-100 text-forest-900 font-semibold uppercase tracking-wider px-2.5 py-1 rounded text-[11px] border border-pistachio-200">
                    ${articulo.categoria}
                  </span>
                  <div class="flex items-center gap-2">
                    <time datetime="${articulo.fecha}">${articulo.fecha}</time>
                    <span>·</span>
                    <span>${articulo.lecturaMinutos || 5} min</span>
                  </div>
                </div>

                <h3 class="font-serif text-xl sm:text-2xl font-bold text-forest-900 group-hover:text-forest-700 transition-colors leading-snug mb-2">
                  <button 
                    type="button" 
                    class="open-article-btn text-left hover:underline focus:outline-none"
                    data-article='${JSON.stringify(articulo).replace(/'/g, "&apos;")}'
                  >
                    ${articulo.titulo}
                  </button>
                </h3>

                ${articulo.subtitulo ? `<p class="font-serif italic text-sm text-forest-800 mb-3 leading-relaxed">${articulo.subtitulo}</p>` : ''}

                <div class="text-xs font-sans text-forest-900 font-semibold mb-4 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-forest-700"></span>
                  <span>Por ${articulo.autor}</span>
                </div>

                <p class="text-ink-800 text-sm leading-relaxed mb-6 font-sans line-clamp-3">
                  ${articulo.resumen}
                </p>
              </div>

              <div class="pt-4 border-t border-pistachio-200 flex items-center justify-between gap-3 text-xs font-sans mt-auto">
                <button
                  type="button"
                  class="open-article-btn font-semibold text-forest-900 hover:text-forest-700 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
                  data-article='${JSON.stringify(articulo).replace(/'/g, "&apos;")}'
                >
                  <span>Leer texto completo</span>
                  <svg class="w-3.5 h-3.5 text-forest-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </button>

                <button
                  type="button"
                  class="download-pdf-btn text-forest-900 font-semibold hover:bg-pistachio-100 inline-flex items-center gap-1 bg-pistachio-50 px-2.5 py-1.5 rounded border border-pistachio-300 transition-colors"
                  data-title="${articulo.titulo}"
                  data-autor="${articulo.autor}"
                >
                  <svg class="w-3.5 h-3.5 text-forest-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  <span>PDF</span>
                </button>
              </div>
            </article>
          `;
          grid.appendChild(wrapper);
        });
      }
    }

    renderArticles('Todos');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-forest-800', 'text-white', 'font-semibold', 'shadow-2xs');
          b.classList.add('bg-pistachio-100', 'text-forest-900');
        });
        btn.classList.remove('bg-pistachio-100', 'text-forest-900');
        btn.classList.add('bg-forest-800', 'text-white', 'font-semibold', 'shadow-2xs');

        const cat = btn.getAttribute('data-category') || 'Todos';
        renderArticles(cat);
      });
    });
  });
</script>
