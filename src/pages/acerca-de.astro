---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="Redirigiendo... | Revista Literaria Anfibias" 
  description="Redirección a las secciones oficiales de Revista Literaria Anfibias."
>
  <div class="max-w-2xl mx-auto px-4 py-20 text-center font-sans">
    <span class="text-3xl mb-4 block">🦎</span>
    <h1 class="font-serif text-3xl font-bold text-forest-900 mb-3">Redirigiendo a Sobre la Revista...</h1>
    <p class="text-sm text-ink-700 mb-8 leading-relaxed max-w-md mx-auto font-light">
      Las secciones de la revista cuentan ahora con sus propias páginas independientes:
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={`${baseUrl}sobre-la-revista`} class="bg-forest-800 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-forest-900 transition-colors shadow-2xs">
        Sobre la Revista
      </a>
      <a href={`${baseUrl}equipo-editorial`} class="bg-white border border-pistachio-300 text-forest-900 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-pistachio-100 transition-colors shadow-2xs">
        Equipo Editorial
      </a>
      <a href={`${baseUrl}contacto`} class="bg-white border border-pistachio-300 text-forest-900 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-pistachio-100 transition-colors shadow-2xs">
        Contacto
      </a>
    </div>
  </div>

  <meta http-equiv="refresh" content={`0;url=${baseUrl}sobre-la-revista`} />
  <script define:vars={{ redirectUrl: `${baseUrl}sobre-la-revista` }}>
    window.location.replace(redirectUrl);
  </script>
</Layout>
