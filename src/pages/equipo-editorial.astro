---
import Layout from '../layouts/Layout.astro';
import AboutNavTabs from '../components/AboutNavTabs.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout 
  title="Equipo Editorial | Revista Literaria Anfibias" 
  description="Conoce al comité y equipo editorial oficial de Revista Literaria Anfibias en Chile: investigadoras, académicas y docentes."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 font-sans">
    
    <!-- Pestañas de Navegación de la Sección Acerca de -->
    <AboutNavTabs activeTab="equipo-editorial" />

    <!-- Header de la sección -->
    <header class="border-b border-pistachio-300 pb-8 mb-10">
      <span class="text-xs font-mono uppercase tracking-widest text-forest-800 font-semibold block mb-2">Comité & Redacción</span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-forest-900 leading-tight mb-4">
        Equipo Editorial
      </h1>
      <p class="font-serif italic text-lg text-forest-800">
        «Académicas, investigadoras y docentes a cargo de la gestión, dictaminación y cuidado de cada volumen.»
      </p>
    </header>

    <!-- Fichas del Equipo -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
      
      <!-- Alexandra Novoa Romero -->
      <div class="bg-white border border-pistachio-300 rounded-xl p-6 flex flex-col justify-between shadow-2xs md:col-span-3">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-forest-800 font-semibold block mb-1">Fundadora & Directora General</span>
          <h2 class="font-serif text-2xl font-bold text-forest-900 mb-2">Alexandra Novoa Romero</h2>
          <p class="text-sm text-ink-700 leading-relaxed font-light">
            Investigadora, profesora de Castellano y Comunicación y doctora (c) en Literatura Latinoamericana. Su línea de investigación se centra en el análisis de la diversidad sexual y las representaciones de género en la literatura, desde una perspectiva crítica sustentada en los estudios de género y los estudios queer. Fundadora y directora de <em>Revista Literaria Anfibias</em>.
          </p>
        </div>
      </div>

      <!-- Jana Aravena Riquelme -->
      <div class="bg-white border border-pistachio-300 rounded-xl p-6 flex flex-col justify-between shadow-2xs md:col-span-1 border-t-4 border-t-forest-800">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-forest-800 font-semibold block mb-1">Coordinación Editorial</span>
          <h2 class="font-serif text-xl font-bold text-forest-900 mb-2">Jana Aravena Riquelme</h2>
          <p class="text-xs text-ink-700 leading-relaxed font-light">
            Doctora (c) en Historia, investigadora y profesora de filosofía. Su área de estudio es historia feminista de las mujeres intelectuales, con especial atención a cuestiones epistemológicas y de contextos socio-históricos de la producción del conocimiento femenino.
          </p>
        </div>
      </div>

      <!-- Pamela Valdés Peña -->
      <div class="bg-white border border-pistachio-300 rounded-xl p-6 flex flex-col justify-between shadow-2xs md:col-span-2 border-t-4 border-t-forest-800">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-forest-800 font-semibold block mb-1">Coordinación Editorial</span>
          <h2 class="font-serif text-xl font-bold text-forest-900 mb-2">Pamela Valdés Peña</h2>
          <p class="text-xs text-ink-700 leading-relaxed font-light">
            Doctora (c) en Literatura Latinoamericana, investigadora, Magíster en Literaturas hispánicas y profesora de Español. Sus áreas de investigación prioritarias son la poesía chilena contemporánea y los estudios intermediales.
          </p>
        </div>
      </div>

    </div>

    <!-- Enlaces de navegación rápida entre pestañas -->
    <div class="border-t border-pistachio-300 pt-8 flex flex-wrap gap-4 justify-between items-center text-xs">
      <a 
        href={`${baseUrl}sobre-la-revista`}
        class="inline-flex items-center gap-1.5 font-semibold text-forest-900 hover:text-forest-700 bg-white border border-pistachio-300 px-4 py-2.5 rounded-lg shadow-2xs transition-colors"
      >
        <span>← Volver a Sobre la Revista</span>
      </a>
      <a 
        href={`${baseUrl}contacto`}
        class="inline-flex items-center gap-1.5 font-semibold text-white bg-forest-800 hover:bg-forest-900 px-4 py-2.5 rounded-lg shadow-2xs transition-colors"
      >
        <span>Pestaña Siguiente: Contacto →</span>
      </a>
    </div>

  </div>
</Layout>
